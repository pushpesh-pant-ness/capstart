# Copy this file to .env and fill in your values - .env is git-ignored and is
# the only place your AWS credentials live on disk (see instructions.md step 2).
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Only needed if using temporary STS credentials instead of a long-lived IAM user.
AWS_SESSION_TOKEN=

# Optional: only needed if you set LANGSMITH_ENABLED=true in agent/k8s/deployment.yaml
# to trace the diagnosis pipeline (context gathering + Bedrock calls) in LangSmith.
LANGSMITH_API_KEY=
